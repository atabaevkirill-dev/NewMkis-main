{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONCAM Cockpit",
  "version": "0.1.0",
  "identifier": "ru.oncam.cockpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ONCAM · Axis Fusion Cockpit",
        "width": 1536,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#07090c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
